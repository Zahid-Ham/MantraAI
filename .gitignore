# ============================================================
#  MantraAI — .gitignore
# ============================================================

# ──────────────────────────────────────────────────────────────
# SECRETS & ENVIRONMENT FILES  (never commit these!)
# ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ──────────────────────────────────────────────────────────────
# NODE / FRONTEND
# ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
jspm_packages/

# Vite build output
dist/
dist-ssr/
.vite/

# ──────────────────────────────────────────────────────────────
# PYTHON / BACKEND
# ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.virtualenv/

# FastAPI / Uvicorn
*.pid

# ──────────────────────────────────────────────────────────────
# DATASETS & LARGE FILES  (use Git LFS or separate storage)
# ──────────────────────────────────────────────────────────────
*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# ML model artifacts
*.pt
*.pth
*.onnx
*.safetensors
ml/models/
ml/checkpoints/

# ──────────────────────────────────────────────────────────────
# LOGS & DATABASES
# ──────────────────────────────────────────────────────────────
*.log
*.sqlite
*.sqlite3
*.db

# ──────────────────────────────────────────────────────────────
# OS FILES
# ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────────────────────
# EDITORS & IDEs
# ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?
*~

# ──────────────────────────────────────────────────────────────
# MISC
# ──────────────────────────────────────────────────────────────
context.md
*.tmp
*.bak
*.cache
.cache/
coverage/
.nyc_output/
