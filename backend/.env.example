# MantraAI Backend configuration
# Database configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mantraai

# AI Report configuration (Groq Console)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Firebase Admin SDK credentials (identity/auth validation)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"

# CORS configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting & DoS Protection
RATE_LIMIT_ENABLED=true
# For distributed multi-worker production deployments, configure Redis:
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_ASSESSMENT_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=524288
